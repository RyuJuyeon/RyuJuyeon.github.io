---
import '../styles/global.css';
import SubjectNavigation from '../components/SubjectNavigation.astro';
const { title = '고등 수학 탐구 아카이브' } = Astro.props;
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content="2022 개정 교육과정 기반 고등학교 수학 학습자료와 수학 탐구 실험실" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">본문으로 바로가기</a>
		<header class="site-header"><div class="wrap header-inner"><a href="/" class="brand"><span class="brand-icon">m↗</span><span>고등 수학 탐구 아카이브<small>HIGH SCHOOL MATH ARCHIVE</small></span></a><nav aria-label="주 메뉴"><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>홈</a><a href="/subjects/">학습자료실</a><a href="/#lab">수학 탐구 실험실</a><a href="/#curriculum">교육과정</a></nav><span class="header-label">배움에 탐구를 더하다 ✳</span></div></header>
		<SubjectNavigation />
		<slot />
		<footer class="wrap site-footer"><div><a href="/" class="footer-brand">고등 수학 탐구 아카이브</a><p>질문하고, 발견하고, 이해하는 수학.</p></div><span>2022 개정 교육과정 기반 학습 프로젝트</span><a href="#main">맨 위로 ↑</a></footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

