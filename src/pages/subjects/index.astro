---
import Layout from '../../layouts/Layout.astro';
import SubjectCards from '../../components/SubjectCards.astro';
import { subjects } from '../../data/subjects';
---
<Layout title="전체 과목·단원 탐색 | 고등 수학 탐구 아카이브">
  <main id="main" class="wrap detail-page">
    <div class="eyebrow">SUBJECT ARCHIVE</div><h1>전체 과목·단원 탐색</h1>
    <p>{subjects.length}개 과목, {subjects.reduce((count, subject) => count + subject.lessonCount, 0)}개 소단원을 탐색할 수 있습니다. 과목을 선택하면 대단원·중단원·소단원 목록으로 이동합니다.</p>
    <p>모든 소단원에서 필기장을 이용할 수 있습니다. 아직 제작되지 않은 개념학습지·정답·실험·평가는 해당 영역에 ‘준비 중’으로 표시합니다.</p>
    <SubjectCards />
  </main>
</Layout>
